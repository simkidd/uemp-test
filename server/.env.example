# ========================================================
# UEMP - University Education Management Portal
# Backend Environment Configuration (.env.example)
# ========================================================

# Application Environment
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# Frontend URL (for CORS)
CORS_ORIGIN=http://localhost:3000

# Database Configuration (MongoDB)
DB_NAME=uemp_dev_db
MONGO_URI=mongodb://127.0.0.1:27017/uemp_dev_db

# Authentication & JWT Configuration
JWT_SECRET=your-secure-jwt-access-secret-min-32-chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-secure-jwt-refresh-secret-min-32-chars
JWT_REFRESH_EXPIRES_IN=30d

# Cloudinary Media Storage (Avatars / Documents)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
